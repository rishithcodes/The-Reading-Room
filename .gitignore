# ==============================================
# Library Management System - .gitignore
# ==============================================

# ============
# SECRETS (NEVER COMMIT)
# ============
backend/src/main/resources/application.properties
*.env
frontend/.env
.env
.env.local
.env.production
**/*.secret
**/secrets/

# ============
# Java / Maven
# ============
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper
.mvn/
mvnw
mvnw.cmd

# IDE
.idea/
*.iml
*.iws
*.ipr
.eclipse/
.settings/
.project
.classpath

# Logs
logs/
*.log
log/

# ============
# Node.js / React
# ============
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/
frontend/.cache/
frontend/.parcel-cache/

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ============
# macOS
# ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============
# VS Code
# ============
.vscode/
*.code-workspace

# ============
# Uploads / Media
# ============
uploads/
public/uploads/
*.jpg
*.jpeg
*.png
*.gif
*.pdf
*.docx

# ============
# Test artifacts
# ============
*.bak
*.tmp
*.swp
